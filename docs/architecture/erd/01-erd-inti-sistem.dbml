  Project pulsewise_erd_inti_sistem {
    database_type: 'PostgreSQL'
    Note: '''
    ERD utama untuk naskah bab inti.
    Fokus pada user, role, profil, verifikasi dokter, diary, vital, serta fondasi modul edukasi CMS.
    Admin direpresentasikan sebagai role pada tabel roles/user_roles, bukan tabel terpisah.
    Hapus akun permanen memakai email_verifications.purpose = account_deletion dan token JWT sementara,
    sehingga tidak dimodelkan sebagai tabel persistence tersendiri.
    '''
  }

  Table roles {
    role_id smallint [pk]
    code varchar(32) [not null, unique]
    label varchar(64) [not null]
  }

  Table users {
    user_id uuid [pk]
    username varchar(100) [not null, unique]
    email varchar(255) [not null, unique]
    first_name varchar(100)
    last_name varchar(100)
    onboarding_completed boolean [not null]
    account_status varchar(32) [not null]
    email_verified_at timestamptz
    is_active boolean [not null]
    created_at timestamptz [not null]
    updated_at timestamptz [not null]
  }

  Table user_roles {
    user_id uuid [pk]
    role_id smallint [pk]
    assigned_at timestamptz [not null]
  }

  Table email_verifications {
    verification_id uuid [pk]
    user_id uuid [not null]
    email varchar(255) [not null]
    purpose varchar(32) [not null, note: 'contoh: email_verification, forgot_password, account_deletion']
    otp_code_hash text [not null]
    expires_at timestamptz [not null]
    consumed_at timestamptz
    created_at timestamptz [not null]
  }

  Table patient_profiles {
    patient_id uuid [pk]
    date_of_birth date
    sex varchar(16)
    body_height_cm decimal(5,2)
    blood_type varchar(3)
    health_connect_preference varchar(32)
    health_connect_status varchar(32)
  }

  Table doctor_profiles {
    doctor_id uuid [pk]
    specialization varchar(120)
    license_no varchar(120)
    hospital_name varchar(150)
    is_verified boolean [not null]
    verified_at timestamptz
    verified_by uuid
    verification_note text
    rejection_reason text
    created_at timestamptz [not null]
  }

  Table emergency_contacts {
    emergency_contact_id uuid [pk]
    user_id uuid [not null]
    contact_label varchar(100) [not null]
    contact_number varchar(50) [not null]
    is_priority boolean [not null]
    created_at timestamptz [not null]
  }

  Table heart_diaries {
    diary_id uuid [pk]
    user_id uuid [not null]
    diary_date date [not null]
    created_at timestamptz [not null]
  }

  Table daily_metrics {
    metric_id uuid [pk]
    diary_id uuid [not null]
    body_height decimal(5,2)
    body_weight decimal(5,2)
    bmi decimal(5,2)
    systolic_pressure int
    diastolic_pressure int
    heart_rate int
    oxygen_saturation int
    time_stamp timestamptz [not null]
  }

  Table daily_symptoms {
    symptom_id uuid [pk]
    diary_id uuid [not null]
    symptom_name varchar(120) [not null]
    symptom_code varchar(80)
    body_area varchar(80)
    is_chest_pain boolean
    intensity smallint
    time_stamp timestamptz [not null]
  }

  Table daily_activities {
    activity_id uuid [pk]
    diary_id uuid [not null]
    name varchar(120) [not null]
    duration int
    heart_rate int
    activity_category varchar(32)
    intensity_level varchar(32)
    time_stamp timestamptz [not null]
  }

  Table daily_consumptions {
    consumption_id uuid [pk]
    diary_id uuid [not null]
    type varchar(50)
    name varchar(120)
    portion varchar(255)
    energy_kcal decimal(10,2)
    protein_g decimal(10,2)
    carbohydrate_g decimal(10,2)
    total_fat_g decimal(10,2)
    time_stamp timestamptz [not null]
  }

  Table daily_sleep_records {
    sleep_record_id uuid [pk]
    diary_id uuid [not null, unique]
    sleep_time time
    wake_time time
    sleep_duration_hours decimal(5,2)
    source varchar(64)
  }

  Table vital_sign_readings {
    reading_id bigint [pk, increment]
    user_id uuid [not null]
    source varchar(64) [not null]
    metric_type varchar(64) [not null]
    value_numeric decimal(10,3)
    unit varchar(32)
    measured_at timestamptz [not null]
    received_at timestamptz [not null]
  }

  Table education_categories {
    category_id uuid [pk]
    slug varchar(120) [not null, unique]
    name varchar(120) [not null]
    description text
    sort_order int [not null]
    is_active boolean [not null]
    created_at timestamptz [not null]
    updated_at timestamptz [not null]
  }

  Table education_articles {
    article_id uuid [pk]
    author_user_id uuid [not null]
    category_id uuid
    slug varchar(200) [not null, unique]
    title varchar(200) [not null]
    excerpt varchar(500)
    content_markdown text [not null]
    cover_image_url text
    cover_image_public_id varchar(255)
    status varchar(32) [not null]
    visibility varchar(32) [not null]
    approved_by uuid
    approved_at timestamptz
    last_reviewed_by uuid
    last_reviewed_at timestamptz
    rejection_reason text
    published_at timestamptz
    like_count int [not null]
    comment_count int [not null]
    view_count int [not null]
    created_at timestamptz [not null]
    updated_at timestamptz [not null]
  }

  Table education_article_revisions {
    revision_id uuid [pk]
    article_id uuid [not null]
    author_user_id uuid [not null]
    category_id uuid
    slug varchar(200) [not null]
    title varchar(200) [not null]
    excerpt varchar(500)
    content_markdown text [not null, note: 'snapshot utuh konten Markdown/MDX']
    cover_image_url text
    cover_image_public_id varchar(255)
    tag_slugs jsonb
    status varchar(32) [not null]
    submitted_at timestamptz
    reviewed_by uuid
    reviewed_at timestamptz
    rejection_reason text
    created_at timestamptz [not null]
    updated_at timestamptz [not null]
  }

  Table education_article_comments {
    comment_id uuid [pk]
    article_id uuid [not null]
    user_id uuid [not null]
    parent_comment_id uuid
    content text [not null]
    status varchar(32) [not null]
    hidden_by uuid
    hidden_at timestamptz
    created_at timestamptz [not null]
    updated_at timestamptz [not null]
  }

  TableGroup inti_otorisasi {
    roles
    users
    user_roles
    email_verifications
  }

  TableGroup profil_pengguna {
    patient_profiles
    doctor_profiles
    emergency_contacts
  }

  TableGroup diary_harian {
    heart_diaries
    daily_metrics
    daily_symptoms
    daily_activities
    daily_consumptions
    daily_sleep_records
  }

  TableGroup vital_biometrik {
    vital_sign_readings
  }

  TableGroup edukasi_inti {
    education_categories
    education_articles
    education_article_revisions
    education_article_comments
  }

  Ref: user_roles.user_id > users.user_id
  Ref: user_roles.role_id > roles.role_id
  Ref: email_verifications.user_id > users.user_id
  Ref: patient_profiles.patient_id - users.user_id
  Ref: doctor_profiles.doctor_id - users.user_id
  Ref: doctor_profiles.verified_by > users.user_id
  Ref: emergency_contacts.user_id > users.user_id
  Ref: heart_diaries.user_id > users.user_id
  Ref: daily_metrics.diary_id > heart_diaries.diary_id
  Ref: daily_symptoms.diary_id > heart_diaries.diary_id
  Ref: daily_activities.diary_id > heart_diaries.diary_id
  Ref: daily_consumptions.diary_id > heart_diaries.diary_id
  Ref: daily_sleep_records.diary_id - heart_diaries.diary_id
  Ref: vital_sign_readings.user_id > users.user_id
  Ref: education_articles.author_user_id > users.user_id
  Ref: education_articles.category_id > education_categories.category_id
  Ref: education_articles.approved_by > users.user_id
  Ref: education_articles.last_reviewed_by > users.user_id
  Ref: education_article_revisions.article_id > education_articles.article_id
  Ref: education_article_revisions.author_user_id > users.user_id
  Ref: education_article_revisions.category_id > education_categories.category_id
  Ref: education_article_revisions.reviewed_by > users.user_id
  Ref: education_article_comments.article_id > education_articles.article_id
  Ref: education_article_comments.user_id > users.user_id
  Ref: education_article_comments.parent_comment_id > education_article_comments.comment_id
  Ref: education_article_comments.hidden_by > users.user_id
